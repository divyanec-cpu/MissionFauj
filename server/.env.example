# Copy this file to .env and fill in real values.

# Postgres connection string. For local dev, point at a local Postgres instance;
# in production (Render) this is provided by the managed Postgres add-on.
DATABASE_URL="postgresql://missionfauj:missionfauj_dev@localhost:5432/missionfauj"

# JWT signing secret for the short-lived phone/age verification tokens issued
# during the login sequence.
JWT_SECRET="change-me-to-a-long-random-string"

# MSG91 OTP send/verify happens client-side now (Render's outbound IP gets
# intermittently blocked by MSG91's widget anti-abuse layer — see git
# history), so the widget credentials live in the frontend's VITE_MSG91_*
# env vars instead, not here.

PORT=4000
