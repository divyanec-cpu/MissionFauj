# Copy this file to .env and fill in real values.

# Postgres connection string. For local dev, point at a local Postgres instance;
# in production (Render) this is provided by the managed Postgres add-on.
DATABASE_URL="postgresql://missionfauj:missionfauj_dev@localhost:5432/missionfauj"

# JWT signing secret for the short-lived phone/age verification tokens issued
# during the login sequence.
JWT_SECRET="change-me-to-a-long-random-string"

# MSG91 OTP send/verify happens client-side (Render's outbound IP gets
# intermittently blocked by MSG91's widget anti-abuse layer — see git
# history), so the widget credentials live in the frontend's VITE_MSG91_*
# env vars, not here.
#
# This is different: your MSG91 account AUTHKEY, server-only and never
# VITE_-prefixed. With it set, /auth/verify-otp re-checks MSG91's access token
# and requires it to belong to the number being claimed, which is what makes
# sign-in actually proven rather than merely asserted. The verifyAccessToken
# endpoint is reachable from Render even though the send/verify ones were
# blocked (confirmed via /admin/diagnostics).
#
# Leaving it unset is NOT a neutral default: sign-in falls back to trusting the
# client, so anyone can mint a token for any phone number without an SMS.
# /admin/diagnostics shows which mode is live.
MSG91_AUTH_KEY=

# Local dev port. Deliberately not 4000 — another project on the same machine
# (CoachYaar) defaults to that, and a collision is silent and confusing: the
# wrong app answers /health, so the server looks healthy while every route
# 404s. Render ignores this value and injects its own PORT in production.
PORT=4010

# Server-only secret for the real AI Assist backend calls (SSB Assistant +
# Current Affairs Digest chat). Never prefix this with VITE_ — unlike the
# MSG91 widget credentials, this is a true high-value secret and must never
# reach the frontend bundle. Get a key from platform.claude.com.
ANTHROPIC_API_KEY="sk-ant-..."

# Bootstraps the first /admin login (real email+password account, not a
# shared token). Only takes effect once, at server startup, while the
# AdminUser table is empty — pick real values you'll remember, set them
# directly in Render's dashboard for production, and log in at /admin/login.
# Safe to leave set permanently; it's a no-op once an admin account exists.
ADMIN_EMAIL="you@example.com"
ADMIN_BOOTSTRAP_PASSWORD="change-me-to-a-long-random-string"
